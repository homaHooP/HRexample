@using HRexample.Models
@model IEnumerable<Application>

@{
    ViewData["Title"] = "Заявки кандидатів";
}

<div class="requirements-page">

    <div class="page-header">
        <div>
            <h1>Заявки кандидатів</h1>
            <p class="subtitle">Перелік поданих заявок на вакансії</p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <h3>Поки що жодних заявок не подано</h3>
        </div>
    }
    else
    {
        <div class="requirements-grid">
            @foreach (var application in Model)
            {
                <div class="requirement-card">

                    <div class="card-content">
                        <h2>@application.Name</h2>
                        <h4>@application.JobRequirement.Position</h4>
                        <div class="skills">
                            <h4>Email: @application.Email</h4>
                            <p>@application.CreatedAt.ToString("dd.MM.yyyy")</p>
                        </div>
                    </div>

                    <div class="card-actions">
                        <button type="button"
                                class="btn btn-details copy-resume-link"
                                data-id="@application.Id">
                            Переглянути резюме
                        </button>
                    </div>
                    <div class="card-actions">
                        <a type="button"
                                class="btn btn-details"
                                asp-controller="ModelResponses"
                                asp-action="Details"
                                asp-route-applicationId="@application.Id">
                            Огляд ШІ
                        </a>
                    </div>
                </div>
            }
        </div>
    }

</div>

<div id="toast" class="toast"></div>

<style>
    .requirements-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 32px;
        }

    .subtitle {
        margin: 8px 0 0;
        color: #777;
    }

    .requirements-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
    }

    .requirement-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 220px;
        padding: 24px;
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .requirement-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 7px 20px rgba(0, 0, 0, 0.1);
        }

        .requirement-card h2 {
            margin: 0 0 20px;
            font-size: 23px;
            color: #222;
        }

    .skills h4 {
        margin: 0 0 7px;
        font-size: 15px;
        color: #666;
    }

    .skills p {
        margin: 0;
        line-height: 1.6;
        color: #333;
        word-break: break-word;
    }

    .card-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .btn {
        display: inline-block;
        padding: 9px 16px;
        border-radius: 8px;
        text-decoration: none;
        border: none;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: 0.2s;
        font-family: inherit;
    }

    .btn-details {
        background: #f0f4ff;
        color: #2457c5;
    }

        .btn-details:hover {
            background: #dfe8ff;
            color: #1745a5;
        }

        .btn-details:disabled {
            opacity: 0.6;
            cursor: default;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        border: 2px dashed #ddd;
        border-radius: 14px;
        color: #777;
    }

        .empty-state h3 {
            margin-bottom: 8px;
            color: #444;
        }

    /* Toast-сповіщення */
    .toast {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%) translateY(20px);
        background: #222;
        color: white;
        padding: 12px 22px;
        border-radius: 8px;
        font-size: 14px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease, transform 0.25s ease;
        z-index: 1000;
    }

        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        .toast.error {
            background: #d63333;
        }
</style>

@section Scripts {
    <script>
        function showToast(message, isError) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.classList.toggle('error', !!isError);
            toast.classList.add('show');
            clearTimeout(toast._hideTimeout);
            toast._hideTimeout = setTimeout(() => {
                toast.classList.remove('show');
            }, 2500);
        }

        document.querySelectorAll('.copy-resume-link').forEach(button => {
            button.addEventListener('click', async () => {
                const id = button.getAttribute('data-id');
                button.disabled = true;

                try {
                    const response = await fetch(`/Applications/GetResumeLink/${id}`);
                    if (!response.ok) {
                        throw new Error('Не вдалося отримати посилання');
                    }

                    const data = await response.json();
                    await navigator.clipboard.writeText(data.url);
                    showToast('Посилання на резюме скопійовано в буфер обміну');
                } catch (err) {
                    showToast('Не вдалося скопіювати посилання', true);
                } finally {
                    button.disabled = false;
                }
            });
        });
    </script>
}