@using HRexample.Models
@model IEnumerable<JobRequirement>

@{
    ViewData["Title"] = "Вимоги до вакансій";
}

<div class="requirements-page">

    <div class="page-header">
        <div>
            <h1>Посади</h1>
            <p class="subtitle">Перелік позицій та вимог до кандидатів</p>
        </div>

        <a class="btn btn-primary" asp-action="Create">
            + Додати посаду
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <h3>Поки що жодних посад не додано</h3>
        </div>
    }
    else
    {
        <div class="requirements-grid">
            @foreach (var requirement in Model)
            {
                <div class="requirement-card">

                    <div class="card-content">
                        <h2>@requirement.Position</h2>
                    </div>

                    <div class="card-actions">
                        <a class="btn btn-edit"
                           asp-action="Create"
                           asp-controller="Applications"
                           asp-route-positionId="@requirement.Id">
                           Подати заявку
                        </a>

                        <a class="btn btn-delete"
                           asp-controller="ModelResponses"
                           asp-action="Index">
                           Звіт
                        </a>
                    </div>

                </div>
            }
        </div>
    }

</div>

<style>    
    .requirements-page {        
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 32px;
        }

    .subtitle {
        margin: 8px 0 0;
        color: #777;
    }

    .requirements-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
    }

    .requirement-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 220px;
        padding: 24px;
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .requirement-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 7px 20px rgba(0, 0, 0, 0.1);
        }

        .requirement-card h2 {
            margin: 0 0 20px;
            font-size: 23px;
            color: #222;
        }

    .skills h4 {
        margin: 0 0 7px;
        font-size: 15px;
        color: #666;
    }

    .skills p {
        margin: 0;
        line-height: 1.6;
        color: #333;
    }

    .card-actions {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .btn {
        display: inline-block;
        padding: 9px 16px;
        border-radius: 8px;
        text-decoration: none;
        border: none;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-primary {
        background: #0d6efd;
        color: white;
    }

        .btn-primary:hover {
            background: #0b5ed7;
            color: white;
        }

    .btn-edit {
        background: #f0f4ff;
        color: #2457c5;
    }

        .btn-edit:hover {
            background: #dfe8ff;
            color: #1745a5;
        }

    .btn-delete {
        background: #fff0f0;
        color: #d63333;
    }

        .btn-delete:hover {
            background: #ffe0e0;
            color: #b42323;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        border: 2px dashed #ddd;
        border-radius: 14px;
        color: #777;
    }

        .empty-state h3 {
            margin-bottom: 8px;
            color: #444;
        }

        .empty-state p {
            margin-bottom: 20px;
        }
</style>