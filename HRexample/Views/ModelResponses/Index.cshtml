@using HRexample.Models
@model List<Application>

@{
    ViewData["Title"] = "Огляд заявок ШІ";
    var averageFit = ViewBag.AverageFit as double?;
}

<div class="review-page">
    <div class="review-card">

        <div class="page-header">
            <h1>Огляд заявок ШІ</h1>
            <p>Стислі оцінки резюме кандидатів. Відкрийте заявку, щоб переглянути деталі або запросити огляд.</p>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">Заявок, перевірених ші, поки немає.</div>
        }
        else
        {
            @foreach (var group in Model.GroupBy(a => a.JobRequirement?.Position ?? "Без позиції"))
            {
                <section class="position-group">
                    <h2 class="position-title">
                        @group.Key
                        <span class="position-count">@group.Count()</span>
                    </h2>

                    <div class="application-list">
                        @foreach (var app in group)
                        {
                            var fit = app.ModelResponse?.PercentageFitForJob;

                            <a class="application-row" asp-action="Details" asp-route-applicationId="@app.Id">
                                <div class="applicant">
                                    <div class="applicant-name">@app.Name</div>
                                    <div class="applicant-meta">
                                        @app.Email · @app.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </div>
                                </div>

                                @if (fit is int f)
                                {
                                    <div class="fit-summary">
                                        <div class="fit-bar"><div class="fit-bar-fill @FitClass(f)" style="width:@(f)%"></div></div>
                                        <span class="fit-badge @FitClass(f)">@f%</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="status-badge">Не проаналізовано</span>
                                }
                            </a>
                        }
                    </div>
                </section>
            }
        }

    </div>

    <aside class="metrics-card">
        <h2 class="metrics-title">Загальні метрики</h2>

        <div class="metric">
            <div class="metric-label">Середня відповідність</div>
            @if (averageFit is double avg)
            {
                <div class="metric-value @FitClass((int)avg)">@avg%</div>
            }
            else
            {
                <div class="metric-value">—</div>
            }
            <div class="metric-hint">за всіма оглядами ШІ (@Model.Count)</div>
        </div>

        <div class="metric">
            <div class="metric-label">Подані заявки по датах</div>
            <canvas id="applicationsChart" height="220"></canvas>
        </div>
    </aside>
</div>

@functions {
    // Колір оцінки залежно від відсотка відповідності
    static string FitClass(int fit) => fit >= 75 ? "fit-high" : fit >= 50 ? "fit-mid" : "fit-low";
}

<style>
    .review-page {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        align-items: start;
        gap: 24px;
        max-width: 1240px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .metrics-card {
        position: sticky;
        top: 20px;
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
    }

    .metrics-title {
        margin: 0 0 20px;
        font-size: 18px;
        font-weight: 600;
        color: #333;
    }

    .metric + .metric {
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }

    .metric-label {
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #555;
    }

    .metric-value {
        font-size: 36px;
        font-weight: 700;
        line-height: 1.1;
        color: #222;
        background: none !important;
    }

    .metric-hint {
        margin-top: 4px;
        font-size: 13px;
        color: #888;
    }

    .review-card {
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        padding: 32px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
    }

    .page-header {
        margin-bottom: 30px;
    }

        .page-header h1 {
            margin: 0 0 8px;
            font-size: 30px;
            color: #222;
        }

        .page-header p {
            margin: 0;
            color: #777;
        }

    .empty-state {
        padding: 40px 20px;
        text-align: center;
        color: #777;
        border: 1px dashed #d8d8d8;
        border-radius: 10px;
    }

    .position-group + .position-group {
        margin-top: 32px;
    }

    .position-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 12px;
        font-size: 18px;
        font-weight: 600;
        color: #333;
    }

    .position-count {
        padding: 2px 9px;
        font-size: 13px;
        font-weight: 500;
        color: #555;
        background: #f1f3f5;
        border-radius: 999px;
    }

    .application-list {
        border: 1px solid #eee;
        border-radius: 10px;
        overflow: hidden;
    }

    .application-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 14px 18px;
        color: inherit;
        text-decoration: none;
        transition: background 0.2s;
    }

        .application-row + .application-row {
            border-top: 1px solid #eee;
        }

        .application-row:hover {
            background: #f8faff;
        }

    .applicant {
        min-width: 0;
    }

    .applicant-name {
        font-size: 15px;
        font-weight: 600;
        color: #222;
    }

    .applicant-meta {
        margin-top: 3px;
        font-size: 13px;
        color: #888;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .fit-summary {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
    }

    .fit-bar {
        width: 120px;
        height: 6px;
        background: #eee;
        border-radius: 999px;
        overflow: hidden;
    }

    .fit-bar-fill {
        height: 100%;
        border-radius: 999px;
    }

    .fit-badge {
        min-width: 48px;
        text-align: right;
        font-size: 15px;
        font-weight: 600;
        background: none !important;
    }

    .fit-high { background: #1f9d55; color: #1f9d55; }
    .fit-mid { background: #e0a100; color: #b88400; }
    .fit-low { background: #d63333; color: #d63333; }

    .status-badge {
        flex-shrink: 0;
        padding: 4px 10px;
        font-size: 13px;
        color: #777;
        background: #f1f3f5;
        border-radius: 999px;
    }

    @@media (max-width: 992px) {
        .review-page { grid-template-columns: 1fr; }
        .metrics-card { position: static; }
    }

    @@media (max-width: 600px) {
        .review-card { padding: 20px; }
        .application-row { flex-wrap: wrap; }
        .fit-bar { width: 80px; }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Графік кількості поданих заявок по датах
        new Chart(document.getElementById('applicationsChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels)),
                datasets: [{
                    label: 'Заявки',
                    data: @Html.Raw(Json.Serialize(ViewBag.ChartValues)),
                    backgroundColor: '#0d6efd',
                    borderRadius: 4
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    </script>
}
